# Example 6: Count Letters, Numbers, and Special Characters
# ------------------------------------------------------------------------------
text = input("Enter a string: ")

letters = 0
digits = 0
special = 0

for ch in text:
    if ch.isalpha():
        letters += 1
    elif ch.isdigit():
        digits += 1
    else:
        special += 1

print("Total Letters:", letters)
print("Total Digits:", digits)
print("Special Characters:", special)


