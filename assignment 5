# Assignment No. 5 - Python String Operations & Regular Expressions

import re


# ------------------------------------------------------------------------------
# 1. Function Using isalnum() (Without Regex)
# ------------------------------------------------------------------------------
def check_string_alphanumeric(text):
    """
    Checks whether a string contains ONLY uppercase letters (A-Z),
    lowercase letters (a-z), and digits (0-9) using isalnum().
    """
    if text.isalnum():
        return "Valid: String contains only letters and numbers."
    else:
        return "Invalid: String contains special characters."


user_input = input("Enter a string: ")
result = check_string_alphanumeric(user_input)
print(result)


# ------------------------------------------------------------------------------
# 2. Function Using Regular Expressions (Regex)
# ------------------------------------------------------------------------------
def check_string_regex(text):
    """
    Checks whether a string contains only A-Z, a-z, 0-9 using Regular Expressions.
    """
    pattern = r"^[A-Za-z0-9]+$"
    # ^          -> start of string
    # $          -> end of string
    # +          -> one or more characters
    # A-Za-z0-9  -> allowed characters

    if re.match(pattern, text):
        return "Valid: String contains only allowed characters."
    else:
        return "Invalid: Contains characters outside A-Z, a-z, 0-9."


user_input = input("Enter a string: ")
print(check_string_regex(user_input))


