def add_if_same_size(m1, m2):
    if len(m1) == len(m2) and len(m1[0]) == len(m2[0]):
        result = []
        for i in range(len(m1)):
            row = []
            for j in range(len(m1[0])):
                row.append(m1[i][j] + m2[i][j])
            result.append(row)
        return result
    else:
        return "Matrices cannot be added (dimension mismatch)"

