# ------------------------------
# Matrix Operations Using Lists
# ------------------------------

# Function to create a matrix using nested lists
def create_matrix(rows, cols):
    """
    This function creates a matrix (list of lists)
    by taking user input for each element.
    """
    matrix = []
    print(f"\nEnter elements for a {rows}x{cols} matrix:")

    for i in range(rows):
        row = []  # Empty row list
        for j in range(cols):
            value = int(input(f"Enter element at position ({i},{j}): "))
            row.append(value)
        matrix.append(row)

    return matrix


# Function to add two matrices element-wise
def add_matrices(mat1, mat2):
    """
    This function adds two matrices element-wise.
    Both matrices MUST be of the same dimensions.
    """
    rows = len(mat1)
    cols = len(mat1[0])

    result = []

    for i in range(rows):
        row = []
        for j in range(cols):
            row.append(mat1[i][j] + mat2[i][j])  # Add corresponding elements
        result.append(row)

    return result


# Function to display a matrix in clean format
def display_matrix(matrix, title="Matrix"):
    print(f"\n{title}:")
    for row in matrix:
        print(row)


# ------------------------------
# DRIVER CODE
# ------------------------------

# Taking number of rows & columns
r = int(input("Enter number of rows: "))
c = int(input("Enter number of columns: "))

# Creating two matrices
matrix1 = create_matrix(r, c)
matrix2 = create_matrix(r, c)

# Display the matrices
display_matrix(matrix1, "Matrix 1")
display_matrix(matrix2, "Matrix 2")

# Performing matrix addition
result_matrix = add_matrices(matrix1, matrix2)

