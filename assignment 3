def best_two_avg(m1, m2, m3):
    marks = sorted([m1, m2, m3], reverse=True)
    return (marks[0] + marks[1]) / 2

def grade(avg):
    if avg >= 80:
        return "A"
    elif avg >= 60:
        return "B"
    else:
        return "C"

