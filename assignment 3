def calculate_fare(distance, passenger_type, age):

    base_rate = 10  # ₹10 per km
    fare = distance * base_rate

    # Apply discount
    if passenger_type.lower() == "student":
        fare *= 0.80   # 20% discount
    elif passenger_type.lower() == "senior" or age >= 60:
        fare *= 0.70   # 30% discount

    return fare


def print_ticket(name, distance, fare):

    print("\n----- Bus Ticket -----")
    print(f"Passenger Name : {name}")
    print(f"Distance       : {distance} km")
    print(f"Total Fare     : ₹{fare:.2f}")
    print("----------------------")


