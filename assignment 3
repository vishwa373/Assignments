def calculate_bill(pizzas, toppings_per_pizza):
    """
    Calculate the total cost of the pizza order.

    Parameters:
        pizzas (int): Number of pizzas ordered
        toppings_per_pizza (int): Number of toppings per pizza

    Returns:
        int: Total bill amount in ₹
    """
    base_price = 150
    topping_price = 20
    delivery_charge = 50

    # Calculate total pizza + topping cost
    total = (base_price + topping_price * toppings_per_pizza) * pizzas

    # Add delivery charge if total is 500 or less
    if total <= 500:
        total += delivery_charge

    return total


def display_bill(name, amount):
    """
    Display a friendly bill message.
    """
    print(f"Hello {name}, your total bill is ₹{amount}.")


