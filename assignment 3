def get_item_price(item):
    menu = {"tea":10, "coffee":20, "sandwich":50, "thali":100}
    return menu.get(item.lower(), 0)

def calculate_total(order_list):
    total = 0
    for item in order_list:
        total += get_item_price(item)
    return total

