def extra_charge(usage_gb):
    if usage_gb <= 1.5:
        return 0
    extra = usage_gb - 1.5
    # ₹10 per extra 0.1 GB
    return round((extra / 0.1) * 10, 2)

def show_summary(name, usage, charge):
    print("---- Data Usage Summary ----")
    print("User:", name)
    print("Usage Today:", usage, "GB")
    print("Extra Charge: ₹", charge)

# Example
usage = 2.1
charge = extra_charge(usage)
show_summary("Kush", usage, charge)
