# -----------------------------------------------------------------------------
# LIST OPERATIONS IN PYTHON
# -----------------------------------------------------------------------------

# Creating a list
numbers = [10, 20, 30, 40]
print("Original List:", numbers)
# Output: Original List: [10, 20, 30, 40]

# 1. append() → Add element at end
numbers.append(50)
print("After append(50):", numbers)


# 2. insert() → Insert at specific index
numbers.insert(2, 25)  # Insert 25 at index 2
print("After insert(2, 25):", numbers)

# 3. remove() → Remove first matching element
numbers.remove(40)
print("After remove(40):", numbers)

# 4. pop() → Remove element by index
removed_item = numbers.pop(1)
print("After pop(1):", numbers)
print("Popped Item:", removed_item)

# 5. sort() → Sort the list
numbers.sort()
print("After sort():", numbers)

# 6. reverse() → Reverse the list
numbers.reverse()
print("After reverse():", numbers)

# 7. extend() → Add multiple elements
numbers.extend([60, 70, 80])
print("After extend([60,70,80]):", numbers)

# 8. count() → Count occurrences
print("Count of 25:", numbers.count(25))

# 9. index() → Get index of element
print("Index of 50:", numbers.index(50))
# Output:
# After append(50): [10, 20, 30, 40, 50]
# After insert(2, 25): [10, 20, 25, 30, 40, 50]
# After remove(40): [10, 20, 25, 30, 50]
# After pop(1): [10, 25, 30, 50]
# Popped Item: 20
# After sort(): [10, 25, 30, 50]
# After reverse(): [50, 30, 25, 10]
# After extend([60,70,80]): [50, 30, 25, 10, 60, 70, 80]
# Count of 25: 1
# Index of 50: 0


# -----------------------------------------------------------------------------
# TUPLE OPERATIONS IN PYTHON
# -----------------------------------------------------------------------------

# Creating a tuple
t = (10, 20, 30, 20, 40, 50)
print("Original Tuple:", t)
# Output: Original Tuple: (10, 20, 30, 20, 40, 50)

# 1. count() → Count occurrences of a value
print("Count of 20:", t.count(20))
# Output: Count of 20: 2

# 2. index() → First index of a value
print("Index of 30:", t.index(30))
# Output: Index of 30: 2

# 3. Slicing → t[start:end]
print("Slicing t[1:4]:", t[1:4])
# Output: Slicing t[1:4]: (20, 30, 20)

# 4. Concatenation → Joining two tuples
t2 = (100, 200)
print("Concatenated Tuple:", t + t2)
# Output: Concatenated Tuple: (10, 20, 30, 20, 40, 50, 100, 200)

# 5. Unpacking → Assign tuple values to variables
a, b, c, d, e, f = t
print("Unpacked Values:", a, b, c, d, e, f)
# Output: Unpacked Values: 10 20 30 20 40 50

# 6. Tuple repetition using * operator
print("Tuple repeated 3 times:", t * 3)
# Output: Tuple repeated 3 times: (10, 20, 30, 20, 40, 50, 10, 20, 30, 20, 40, 50, 10, 20, 30, 20, 40, 50)

# 7. max() and min() functions
print("Max value:", max(t))
print("Min value:", min(t))
# Output:
# Max value: 50
# Min value: 10

# 8. len() function
print("Length of tuple:", len(t))
# Output: Length of tuple: 6


# -----------------------------------------------------------------------------
# DICTIONARY
# -----------------------------------------------------------------------------

# Creating dictionary
student = {
    "name": "sachin",
    "age": 18,
    "course": "B.Tech"
}
print("Original Dictionary:", student)
# Output: Original Dictionary: {'name': 'sachin', 'age': 18, 'course': 'B.Tech'}

# 1. Accessing values
print("Name:", student["name"])
# Output: Name: sachin

student["city"] = "Pune"
print("After adding city:", student)
# Output: After adding city: {'name': 'sachin', 'age': 18, 'course': 'B.Tech', 'city': 'Pune'}

# 3. update() → Update or add multiple key-value pairs
student.update({"age": 19, "semester": 1})
print("After update():", student)
# Output: After update(): {'name': 'sachin', 'age': 19, 'course': 'B.Tech', 'city': 'Pune', 'semester': 1}

# 4. pop() → Remove key and return value
removed_age = student.pop("age")
print("After pop('age'):", student)
print("Removed Age:", removed_age)
# Output:
# After pop('age'): {'name': 'sachin', 'course': 'B.Tech', 'city': 'Pune', 'semester': 1}
# Removed Age: 19

# 5. keys(), values(), items()
print("Keys:", student.keys())
print("Values:", student.values())
print("Items:", student.items())
# Output:
# Keys: dict_keys(['name', 'course', 'city', 'semester'])
# Values: dict_values(['sachin', 'B.Tech', 'Pune', 1])
# Items: dict_items([('name', 'sachin'), ('course', 'B.Tech'), ('city', 'Pune'), ('semester', 1)])

# 6. get() → Safe value access
print("Course:", student.get("course"))
# Output: Course: B.Tech

# 7. popitem() → Removes last inserted item
removed_item = student.popitem()
print("After popitem():", student)
print("Removed Item:", removed_item)
# Output:
# After popitem(): {'name': 'sachin', 'course': 'B.Tech', 'city': 'Pune'}
# Removed Item: ('semester', 1)

# 8. clear() → Remove all items
temp_dict = {"a": 1, "b": 2}
temp_dict.clear()
print("After clear():", temp_dict)
# Output: After clear(): {}

# 9. Copy dictionary
new_student = student.copy()
print("Copied dictionary:", new_student)
# Output: Copied dictionary: {'name': 'sachin', 'course': 'B.Tech', 'city': 'Pune'}

# 10. Set default value
student.setdefault("gender", "Female")
print("After setdefault():", student)
# Output: After setdefault(): {'name': 'sachin', 'course': 'B.Tech', 'city': 'Pune', 'gender': 'Female'}
