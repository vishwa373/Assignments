# CLASS QUESTION
# =============================================================================

#list of prices of groceries
groce_lt = [250, 350, 500, 600, 120]
print(groce_lt)
# Output: [250, 350, 500, 600, 120]

#removing any item having price above 500 rupees
groce_lt = [price for price in groce_lt if price<=500]
print(groce_lt)
# Output: [250, 350, 500, 120]

#insert new item at position 2
groce_lt.insert(1, 200)
print(groce_lt)
# Output: [250, 200, 350, 500, 120]

#sorting in ascending order
groce_lt.sort()

print(groce_lt)
# Output: [120, 200, 250, 350, 500]

#printing total sum
listsum = int(groce_lt[0]+groce_lt[1]+groce_lt[2]+groce_lt[3]+groce_lt[4])
print(listsum)
# Output: 1420


