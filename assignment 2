# =============================================================================
# CONDITIONAL STATEMENT - if .... else statement
# =============================================================================

#if example
num = 3
if num >= 0 :
    print('It is positive')
# Output: It is positive

#if else example
num = -1
if num >= 0 :
    print('It is positive')
else :
    print('It is negative')
# Output: It is negative

#if elif else example
num = 0
if num > 0 :
    print('It is positive')
elif num == 0 :
    print('It is zero')
else :
    print('It is negative')
# Output: It is zero


