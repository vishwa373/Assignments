# ==========================================
# PROGRAM 1: Largest of Three Numbers
# ==========================================

# Taking input from the user
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))
c = int(input("Enter third number: "))

# Checking which number is the largest using if...elif...else
if (a > b) and (a > c):
    # Executed only when a is greater than both b and c
    print(a, "is the largest number")
elif (b > a) and (b > c):
    # Executed only when b is greater than both a and c
    print(b, "is the largest number")
else:
    # If neither a nor b is largest → then c is largest
    print(c, "is the largest number")
# Sample run (inputs: 7, 4, 8):
# Enter first number:  7
# Enter second number:  4
# Enter third number:  8
# 8 is the largest number


# ==========================================
# PROGRAM 2: Largest of Three (Handles Equal)
# ==========================================

a = int(input("Enter first number: "))
b = int(input("Enter second number: "))
c = int(input("Enter third number: "))

# First check if all are equal
if a == b == c:
    print("All three numbers are equal")
elif a >= b and a >= c:
    print(a, "is the largest number")
elif b >= a and b >= c:
    print(b, "is the largest number")
else:
    print(c, "is the largest number")
# Sample run (inputs: 67, 57, 78):
# Enter first number:  67
# Enter second number:  57
# Enter third number:  78
# 78 is the largest number


# ==========================================
# LOGICAL & RELATIONAL OPERATORS EXAMPLES
# ==========================================

a = 10
b = 20

# Relational operators: <, >, <=, >=, ==, !=
print("a < b:", a < b)
print("a > b:", a > b)
print("a <= b:", a <= b)
print("a >= b:", a >= b)
print("a == b:", a == b)
print("a != b:", a != b)

# Logical operators: and, or, not
x = 5
y = 15

print("x > 0 and y > 10 →", x > 0 and y > 10)
print("x == 5 or y == 100 →", x == 5 or y == 100)
print("not(x == 5) →", not(x == 5))
# Output:
# a < b: True
# a > b: False
# a <= b: True
# a >= b: False
# a == b: False
# a != b: True
# x > 0 and y > 10 → True
# x == 5 or y == 100 → True
# not(x == 5) → False


